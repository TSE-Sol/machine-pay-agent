{
  "name": "machine-pay-agent",
  "version": "0.1.0",
  "description": "Autonomous payment agent for machines: x402 pay-to-power on Solana. Built from scratch for the UBC 2026 Hackathon.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "agent": "node agent/index.js",
    "keys": "node scripts/make-keys.js",
    "test:pay": "node scripts/test-pay.js",
    "tunnel": "node scripts/tunnel.js",
    "demo:reset": "node scripts/demo-reset.js",
    "test": "node --test --test-reporter=spec agent/*.test.js server/*.test.js streams/*.test.js scripts/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@elevenlabs/elevenlabs-js": "^2.78.0",
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.6.0",
    "@x402/core": "^2.31.0",
    "@x402/express": "^2.31.0",
    "@x402/svm": "^2.31.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  }
}
