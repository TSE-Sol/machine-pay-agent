# Copy to .env and fill in MERCHANT_WALLET. .env is gitignored.

PORT=4020

# Solana devnet RPC (swap in a QuickNode devnet URL for better rate limits)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Circle's USDC mint on Solana devnet
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Public key of the charger owner's wallet (printed by `npm run keys`)
MERCHANT_WALLET=

PRICE_USDC_PER_15MIN=0.20

# Optional: x402 facilitator that verifies and settles payments.
# Default is https://x402.org/facilitator; https://facilitator.payai.network also supports Solana devnet.
# FACILITATOR_URL=https://x402.org/facilitator

# Optional: real seconds per paid "minute". Set to 1 so a 15-minute session ends in 15 seconds (demos).
# DEMO_SECONDS_PER_MINUTE=1

# ---------------------------------------------------------------------------
# Agent (npm run agent)
# ---------------------------------------------------------------------------

# Claude plans which charger to use and for how long. Leave empty to use the rule-based planner.
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5

# CHARGER_SERVER_URL=http://localhost:4020

# Safety limits (enforced in agent/guardrails.js)
MAX_PER_TX_USDC=1.00
DAILY_BUDGET_USDC=5.00
APPROVAL_THRESHOLD_USDC=0.50
MAX_PAYMENTS_PER_10_MIN=5
AGENT_PAUSED=false
# Wallets the agent may pay, comma-separated. Defaults to MERCHANT_WALLET.
# ALLOWED_PAY_TO=

# When to charge, and how far
# LOW_BATTERY_PCT=20
# TARGET_BATTERY_PCT=45
